<!DOCTYPE html>
<html lang="en"><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow, noarchive, noimageindex">
<title>Homepage Brief — Campminder</title>
<style>
/* ─────────────────────────────────────────────
   Campminder Fall Campaign — Homepage Brief
   Neutral shell, matched to the Boulder Events Calendar board.
   Studio Parkside, August 2026
───────────────────────────────────────────── */
:root {
  --ground: #F0F1F2;
  --card: #FFFFFF;
  --card-bright: #FFFFFF;
  --neutral-white: #FFFFFF;
  --ink: #000000;
  --ink-soft: #5B5D5F;
  --paper: #FFFFFF;
  --outline: #E2E4E6;
  --hairline: #E9EAEC;
  --hairline-strong: #000000;
  --hairline-light: rgba(255, 255, 255, 0.3);
  --muted: #A3A6A9;
  --radius: 28px;
  --header-h: 96px;
  --font: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Segoe UI", Helvetica, Arial, sans-serif;

  /* Wireframe frame, dark surface */
  --dark: #000000;
  --dark-2: #141414;
  --dark-line: rgba(255, 255, 255, 0.14);
  --dark-low: rgba(255, 255, 255, 0.44);
}

* { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
body {
  background: var(--ground);
  color: var(--ink);
  font-family: var(--font);
  font-size: 19px;
  line-height: 1.62;
  font-weight: 400;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  padding: 12px;
  padding-top: calc(var(--header-h) + 12px);
}
a { color: var(--ink); text-underline-offset: 3px; }

.stack {
  max-width: 1120px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

/* ---------- Fixed glass header ---------- */
.siteheader {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 60;
  height: var(--header-h);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 0 34px;
  background: rgba(240, 241, 242, 0.62);
  -webkit-backdrop-filter: blur(26px) saturate(165%);
  backdrop-filter: blur(26px) saturate(165%);
  border-bottom: 1px solid var(--outline);
}
@supports not ((backdrop-filter: blur(2px)) or (-webkit-backdrop-filter: blur(2px))) {
  .siteheader { background: rgba(240, 241, 242, 0.96); }
}
.siteheader .logo { height: 19px; }

/* ---------- Cards ---------- */
.card {
  background: var(--card);
  border: 1px solid var(--outline);
  border-radius: var(--radius);
  padding: 64px 72px;
}
.card.dark {
  background: var(--ink);
  border-color: var(--ink);
  color: var(--paper);
}
.card.dark a { color: var(--paper); }
.card.dark .label { color: var(--paper); }
.card.dark p { color: rgba(255, 255, 255, 0.74); }

.botbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24px;
  padding: 28px 16px 40px;
  font-size: 14.5px;
  color: var(--ink-soft);
}
.logo {
  display: block;
  height: 17px;
  width: auto;
  aspect-ratio: 1499.4 / 151;
  fill: var(--ink);
}
.pill-group { display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }

/* ---------- Pills ---------- */
.pill {
  display: inline-block;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: -0.004em;
  padding: 7px 16px 6px;
  border: 1px solid var(--hairline-strong);
  border-radius: 999px;
  white-space: nowrap;
}
.pill.filled { background: var(--ink); border-color: var(--ink); color: var(--paper); }
.pill.light { border-color: var(--outline); color: var(--ink-soft); font-weight: 500; }
/* Third tier, for metadata that sits in a pill row without claiming a place
   in it. Drops the container rather than the contrast. */
.pill.meta {
  border-color: transparent;
  color: var(--ink-soft);
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}
.card.dark .pill { border-color: rgba(255, 255, 255, 0.5); color: var(--paper); }
.card.dark .pill.meta { border-color: transparent; color: rgba(255, 255, 255, 0.62); }
.card.dark .pill.filled { background: var(--paper); border-color: var(--paper); color: var(--ink); }

/* ---------- Hero ---------- */
.hero { padding: 88px 72px 80px; }
.hero-grid { display: flex; justify-content: space-between; align-items: flex-start; gap: 64px; }
.hero-main { flex: 1; min-width: 0; }
/* Sized to sit beside the contents column rather than under it. A proposal
   hero runs larger because its title is two or three words. */
h1 {
  font-size: clamp(40px, 5vw, 68px);
  line-height: 1.0;
  letter-spacing: -0.03em;
  font-weight: 650;
  max-width: 13ch;
}
h1 .h1-sub { display: block; font-weight: 400; color: var(--muted); }
.card.dark.hero .lede {
  margin-top: 30px;
  font-size: 20px;
  color: rgba(255, 255, 255, 0.66);
  letter-spacing: -0.012em;
  max-width: 46ch;
}

/* ---------- Contents, a column beside the title ---------- */
.toc {
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  min-width: 320px;
  padding-top: 6px;
}
.toc a {
  display: flex;
  align-items: baseline;
  gap: 14px;
  font-size: 14.5px;
  color: rgba(255, 255, 255, 0.72);
  text-decoration: none;
  padding: 10.5px 2px 9.5px;
  letter-spacing: -0.005em;
}
.toc a + a { border-top: 1px solid var(--hairline-light); }
.toc a:hover { color: var(--paper); }
.toc-num { font-weight: 600; font-variant-numeric: tabular-nums; color: var(--paper); min-width: 22px; }

/* ---------- Sections ---------- */
.section-grid { display: grid; grid-template-columns: 56px 1fr; gap: 24px; align-items: start; }
.rail-number {
  font-size: 38px;
  font-weight: 300;
  line-height: 1;
  letter-spacing: -0.03em;
  font-variant-numeric: tabular-nums;
  position: sticky;
  top: calc(var(--header-h) + 24px);
}
.section-body h2 {
  font-size: clamp(32px, 3.8vw, 46px);
  font-weight: 600;
  letter-spacing: -0.024em;
  line-height: 1.06;
  margin-bottom: 30px;
  max-width: 20ch;
}
.section-body p { max-width: 64ch; margin-bottom: 25px; }
.section-body p:last-child { margin-bottom: 0; }
.section-body p strong { font-weight: 650; }

/* ---------- Label, sentence case at reading size ---------- */
.label {
  font-size: 22px;
  font-weight: 650;
  letter-spacing: -0.016em;
  line-height: 1.22;
  color: var(--ink);
  margin-bottom: 14px;
}
.section-body .label { margin-top: 48px; }
/* A label sitting straight under the section heading gets the same optical
   gap as body copy. Body copy carries half-leading above its first line and
   a label does not, so the label makes up the difference. */
.section-body h2 + .label { margin-top: 5px; }
.label .lnum { color: var(--muted); font-variant-numeric: tabular-nums; margin-right: 10px; font-weight: 600; }

/* ---------- Ruled rows ---------- */
.rows {
  margin: 26px 0;
  background: var(--card-bright);
  border: 1px solid var(--outline);
  border-radius: 20px;
  padding: 6px 40px 6px 32px;
}
.rows.flat { background: transparent; border: 0; padding: 0; }
.row { display: grid; grid-template-columns: 88px 1fr; gap: 26px; padding: 19px 0; }
.rows .row + .row { border-top: 1px solid var(--hairline); }
.section-body .rows:last-child { margin-bottom: 0; }
.row-num {
  font-size: 14.5px;
  font-weight: 600;
  letter-spacing: 0.02em;
  font-variant-numeric: tabular-nums;
  padding-top: 4px;
  white-space: nowrap;
}
.row-text { max-width: 58ch; line-height: 1.5; }
.row-text strong { font-weight: 650; letter-spacing: -0.006em; }
.row-text p { margin: 0; }
.row-text p + p { margin-top: 10px; }
.row-text .rowpills { display: flex; gap: 7px; flex-wrap: wrap; margin-top: 13px; }
.rows.flat .row { grid-template-columns: 1fr; gap: 0; }
/* Figures in the left column, reading at headline weight so the number is
   the thing scanned and the sentence beside it does the explaining. */
.rows.stat .row { grid-template-columns: 128px 1fr; align-items: baseline; }
.rows.stat .row-num {
  font-size: 32px;
  font-weight: 650;
  letter-spacing: -0.026em;
  line-height: 1.1;
  padding-top: 0;
}

/* ---------- Panels. Two columns is the maximum on this page.
   Three columns sets the measure too tight to read. ---------- */
.duo {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin: 26px 0;
}
.panel {
  background: var(--card-bright);
  border: 1px solid var(--outline);
  border-radius: 20px;
  padding: 36px 34px 38px;
  display: flex;
  flex-direction: column;
}
.panel h3 {
  font-size: 27px;
  font-weight: 600;
  letter-spacing: -0.02em;
  line-height: 1.1;
  margin-bottom: 12px;
}
.panel p { font-size: 17.5px; line-height: 1.5; color: var(--ink-soft); max-width: 44ch; margin: 0; }
.panel .ptop { margin-bottom: 18px; }
.panel .pdiv { border-top: 1px solid var(--hairline); margin: 22px 0 16px; }
.panel .plab { font-size: 17px; font-weight: 650; letter-spacing: -0.008em; margin-bottom: 10px; }
.plist { list-style: none; margin: 0; padding: 0; }
.plist li {
  font-size: 17px;
  color: var(--ink-soft);
  line-height: 1.45;
  padding: 9px 0;
  border-top: 1px solid var(--hairline);
}
.plist li:first-child { border-top: 0; padding-top: 0; }

.duo.one { grid-template-columns: 1fr; }
.panel .plink { margin-top: 20px; }
.panel .plink a {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--ink);
  text-decoration: none;
  font-size: 16.5px;
  font-weight: 600;
  letter-spacing: -0.006em;
  border-bottom: 1px solid var(--outline);
  padding-bottom: 3px;
  transition: border-color 140ms ease;
}
.panel .plink a:hover { border-bottom-color: var(--ink); }
.panel .plink svg {
  width: 12px;
  height: 12px;
  flex: none;
  transition: transform 140ms ease;
}
.panel .plink a:hover svg { transform: translate(2px, -2px); }

/* ---------- Territory copy block ---------- */
.copycard {
  background: var(--card-bright);
  border: 1px solid var(--outline);
  border-radius: 20px;
  padding: 62px 56px 56px;
  margin: 26px 0;
}
.copycard h3 {
  font-size: clamp(40px, 6vw, 68px);
  font-weight: 650;
  line-height: 1.0;
  letter-spacing: -0.038em;
  margin-bottom: 18px;
}
.copycard .cc-sub {
  font-size: clamp(23px, 2.8vw, 30px);
  font-weight: 600;
  letter-spacing: -0.022em;
  line-height: 1.26;
  margin-bottom: 24px;
}
.copycard p.copy { font-size: 20px; color: var(--ink-soft); line-height: 1.5; max-width: 54ch; margin-bottom: 24px; }
.copycard .cc-close { font-size: 20px; font-weight: 600; max-width: 54ch; line-height: 1.5; }
.cc-tagrow { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; margin-top: 30px; }
.cc-tagrow .tagline { font-size: 26px; font-weight: 650; letter-spacing: -0.024em; }

/* ---------- Note, a fact attached to the item it touches ---------- */
.note {
  border: 1px solid var(--outline);
  border-radius: 20px;
  padding: 30px 32px 32px;
  margin: 26px 0;
  background: transparent;
}
.note h5 { font-size: 22px; font-weight: 650; letter-spacing: -0.018em; line-height: 1.2; margin-bottom: 12px; }
.note p { font-size: 17.5px; color: var(--ink-soft); line-height: 1.5; max-width: 66ch; margin: 0; }
.note p + p { margin-top: 13px; }
.note strong { color: var(--ink); font-weight: 650; }

/* ---------- Hierarchy ---------- */
.hier { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; align-items: stretch; margin: 26px 0; }
.hier-side { display: grid; grid-template-rows: 1fr 1fr; gap: 12px; }
.block {
  background: var(--card-bright);
  border: 1px solid var(--outline);
  border-radius: 20px;
  padding: 32px 32px 34px;
  display: flex;
  flex-direction: column;
}
.block .brole { font-size: 17px; font-weight: 650; letter-spacing: -0.008em; color: var(--ink-soft); margin-bottom: 12px; }
.block .nm { font-weight: 650; font-size: 27px; letter-spacing: -0.024em; line-height: 1.1; }
.block .role { color: var(--ink-soft); font-size: 17.5px; margin-top: 9px; line-height: 1.45; }
.block .bdiv { border-top: 1px solid var(--hairline); margin: 22px 0 16px; }
.block .use-l { display: block; font-size: 17px; font-weight: 650; letter-spacing: -0.008em; margin-bottom: 4px; }
.block ul.use { list-style: none; margin: 0; padding: 0; color: var(--ink-soft); font-size: 17px; line-height: 1.45; }
.block ul.use li { padding: 8px 0; border-top: 1px solid var(--hairline); }
.block ul.use li:first-child { border-top: 0; }
.block.leadblock {
  background: var(--ink);
  border-color: var(--ink);
  color: var(--paper);
  justify-content: center;
  padding: 46px 40px;
}
.block.leadblock .brole { color: rgba(255, 255, 255, 0.62); }
.block.leadblock .nm { color: var(--paper); font-size: clamp(38px, 5.4vw, 62px); letter-spacing: -0.038em; line-height: 1.0; }
.block.leadblock .role { color: rgba(255, 255, 255, 0.82); font-size: 23px; margin-top: 18px; max-width: 26ch; line-height: 1.35; }
.block.leadblock .bdiv { border-color: rgba(255, 255, 255, 0.26); margin: 34px 0 20px; }
.block.leadblock .use-l { color: var(--paper); }
.block.leadblock ul.use { color: rgba(255, 255, 255, 0.82); font-size: 19px; max-width: 32ch; line-height: 1.4; }
.block.leadblock ul.use li { border-color: rgba(255, 255, 255, 0.22); padding: 10px 0; }

/* ---------- Wireframe, dark ---------- */
.frame { border: 1px solid var(--dark); border-radius: 20px; background: var(--dark); overflow: hidden; margin: 26px 0; }
.frame-bar {
  display: flex; align-items: center; gap: 10px;
  padding: 14px 20px; border-bottom: 1px solid var(--dark-line); background: var(--dark-2);
}
.frame-bar .dot { width: 9px; height: 9px; border-radius: 50%; background: rgba(255, 255, 255, 0.2); }
.frame-bar .url { font-size: 13.5px; font-weight: 600; color: var(--dark-low); margin-left: 6px; }
.wire.placeholder {
  background: var(--dark);
  aspect-ratio: 16 / 11;
  min-height: 360px;
}
.frame-note {
  font-size: 13.5px; font-weight: 600; color: var(--dark-low);
  padding: 14px 20px; background: var(--dark-2); text-align: right;
  border-top: 1px solid var(--dark-line); letter-spacing: -0.004em;
}

/* ---------- Mobile ---------- */
@media (max-width: 820px) {
  :root { --radius: 22px; --header-h: 68px; }
  body { font-size: 17.5px; padding: 8px; padding-top: calc(var(--header-h) + 8px); }
  .stack { gap: 8px; }
  .siteheader { padding: 0 18px; }
  .siteheader .logo { height: 15px; }
  .pill { font-size: 11.5px; padding: 5px 11px 4px; }
  .card { padding: 40px 26px; }
  .hero { padding: 56px 26px 52px; }
  .hero-grid { flex-direction: column; gap: 0; }
  .hero .lede { font-size: 18px; margin-top: 22px; }
  .botbar { flex-direction: column; gap: 10px; align-items: flex-start; padding: 20px 8px 28px; }
  .section-grid { grid-template-columns: 1fr; gap: 6px; }
  .rail-number { position: static; font-size: 32px; margin-bottom: 8px; }
  .rows { padding: 2px 20px; }
  .row { grid-template-columns: 1fr; gap: 4px; padding: 16px 0; }
  .row-num { font-size: 13px; padding-top: 0; }
  .toc {
    min-width: 0;
    width: 100%;
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid var(--hairline-light);
  }
  .toc a { font-size: 13.5px; padding: 9px 0 8px; }
  .label { font-size: 19.5px; }
  .section-body .label { margin-top: 36px; }
  .duo { grid-template-columns: 1fr; gap: 8px; }
  .panel { padding: 28px 24px 30px; }
  .copycard { padding: 34px 26px 30px; }
  .note { padding: 24px 22px 26px; }
  .hier { grid-template-columns: 1fr; gap: 8px; }
  .hier-side { grid-template-rows: none; gap: 8px; }
  .block { padding: 28px 24px 30px; }
  .block.leadblock { padding: 34px 26px; }
}
a:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; border-radius: 4px; }
</style>
</head>
