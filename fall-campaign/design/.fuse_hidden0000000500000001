<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow, noarchive, noimageindex">
<title>Alternate E — Ruled Grid — Campminder Fall Campaign</title>
<style>
/* ─────────────────────────────────────────────
   Campminder Fall Campaign — Homepage Alternate E
   RULED GRID. The grid is drawn, not implied. Twelve columns
   of hairline rule run the full height of every section, edge
   to edge. Space is made by leaving cells empty. Nothing is a
   card: no radius, no shadow, no traffic lights, no pills.
   Ground is the approved dark plum. Spezia Narrow display,
   Spezia body. Studio Parkside, August 2026
───────────────────────────────────────────── */
:root {
  --sans: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text",
          "Segoe UI", "Helvetica Neue", Helvetica, Arial, sans-serif;
  --bg: #17112a;
  --canvas: #0d0a16;
  --card: #120e1f;
  --ink: #ffffff;
  --body: #e7e3f0;
  --mid: #a79cbd;
  --light: #786d92;
  --rule: rgba(255,255,255,0.16);
  --hair: rgba(255,255,255,0.085);
  --accent: #773dbd;
  --accent-2: #a87be0;
  --accent-line: rgba(168,123,224,0.42);
  --dark: #27065c;
  --dark-2: #380f8c;
  --dark-accent: #c9a9f2;
  --dark-mid: rgba(255,255,255,0.66);
  --dark-low: rgba(255,255,255,0.42);
}
html { color-scheme: dark; }
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { -webkit-text-size-adjust: 100%; }
body {
  font-family: var(--sans);
  color: var(--body);
  background: var(--canvas);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  font-size: 18px; font-weight: 500; line-height: 1.5; letter-spacing: -0.015em;
}
.wrap { max-width: 1520px; margin: 0 auto; padding: 18px 44px; }

/* ── comp chrome ───────────────────────────── */
.conf { border-bottom: 1px solid var(--rule); background: var(--bg); position: sticky; top: 0; z-index: 20; }
.conf .wrap { padding-top: 14px; padding-bottom: 14px; display: flex; justify-content: space-between; align-items: center; gap: 20px; }
.sp-logo { display: block; height: 17px; width: auto; color: var(--ink); flex: none; }
.tags { display: flex; align-items: center; gap: 8px; }
.pill { font-size: 11px; font-weight: 650; letter-spacing: 0.09em; text-transform: uppercase; color: var(--accent-2);
  background: rgba(119,61,189,0.18); border: 1px solid var(--accent-line); border-radius: 100px; padding: 5px 12px; white-space: nowrap; }
.pill.client { color: var(--mid); background: transparent; border-color: var(--rule); }
.masthead { padding: 72px 0 40px; }
.masthead .cm-name { display: block; font-size: 15px; font-weight: 650; color: var(--mid); margin-bottom: 18px; }
.masthead .cm-name .sep { color: var(--accent-line); padding: 0 4px; }
.masthead h1 { font-size: 64px; font-weight: 700; line-height: 1.0; letter-spacing: -0.045em; color: var(--ink); }
.masthead h1 .accent { color: var(--accent-2); }
.masthead .sub { margin-top: 18px; font-size: 19px; color: var(--mid); max-width: 66ch; line-height: 1.5; }
.boardwrap { padding: 28px 0 60px; }
.boardhead { max-width: 1440px; margin: 0 auto 12px; display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; }
.boardhead h2 { font-size: 20px; font-weight: 700; color: var(--ink); letter-spacing: -0.025em; }
.boardhead .bmeta { font-size: 14px; font-weight: 600; color: var(--light); margin-left: auto; }
.board { width: 1440px; margin: 0 auto; background: var(--canvas); border: 1px solid var(--rule); overflow: hidden; }
.boardnote { max-width: 1440px; margin: 14px auto 0; font-size: 14px; font-weight: 600; color: var(--light); line-height: 1.5; }
@media (max-width: 1540px) { .boardwrap { overflow-x: auto; padding-left: 44px; padding-right: 44px; } .boardhead, .board, .boardnote { min-width: 1440px; } }

/* ═════════════════════════════════════════════
   THE PAGE
═════════════════════════════════════════════ */
.hp { font-size: 17px; color: var(--body); position: relative; }

/* the drawn grid. twelve columns of hairline behind every row. */
.row { position: relative; border-bottom: 1px solid var(--rule); }
.lines { position: absolute; inset: 0; z-index: 0; display: grid; grid-template-columns: repeat(12, 1fr); pointer-events: none; }
.lines span { border-left: 1px solid var(--hair); }
.lines span:first-child { border-left: none; }
.cells { position: relative; z-index: 2; display: grid; grid-template-columns: repeat(12, 1fr); }
.c { padding: 40px 26px; min-width: 0; }
.c.pad0 { padding: 0; }
.c.tight { padding: 26px 26px; }

/* span helpers */
.s1{grid-column:span 1}.s2{grid-column:span 2}.s3{grid-column:span 3}.s4{grid-column:span 4}
.s5{grid-column:span 5}.s6{grid-column:span 6}.s7{grid-column:span 7}.s8{grid-column:span 8}
.s9{grid-column:span 9}.s10{grid-column:span 10}.s12{grid-column:span 12}
.bot { display: flex; flex-direction: column; justify-content: flex-end; }
.mid { display: flex; flex-direction: column; justify-content: center; }

/* type */
h1, h2, h3, h4, h5 { font-weight: 700; letter-spacing: -0.045em; line-height: 0.96; color: var(--ink); }
.eyebrow { font-size: 14px; font-weight: 600; letter-spacing: -0.008em; color: var(--accent-2); line-height: 1.3; }
.marg { font-size: 13px; font-weight: 600; color: var(--light); line-height: 1.4; }
.marg b { color: var(--mid); font-weight: 700; }
.dsp { font-size: 78px; }
.dsp.big { font-size: 104px; letter-spacing: -0.05em; }
.dsp.sm { font-size: 46px; letter-spacing: -0.038em; }
.lede { font-size: 22px; font-weight: 600; letter-spacing: -0.022em; color: var(--ink); line-height: 1.28; }
.txt { font-size: 16.5px; color: var(--mid); line-height: 1.5; }
.txt b { color: var(--body); font-weight: 700; }

/* nav — a ruled band, links sit in their own cells */
.hp-nav { border-bottom: 1px solid var(--rule); position: relative; }
.hp-nav .cells { align-items: center; min-height: 74px; }
.hp-nav .c { padding: 0 22px; display: flex; align-items: center; height: 74px; }
.cmlogo { display: block; height: 24px; width: auto; }
.hp-nav a { font-size: 14.5px; font-weight: 600; color: var(--mid); text-decoration: none; }
.hp-nav .cta { justify-content: flex-start; }

/* buttons — rectangles and rules, never pills */
.btn { display: inline-flex; align-items: center; justify-content: center; font-size: 14.5px; font-weight: 650;
  letter-spacing: -0.008em; padding: 13px 24px; text-decoration: none; border: 1px solid transparent; white-space: nowrap; }
.btn.solid { background: var(--ink); color: #14101f; }
.btn.line { background: transparent; color: var(--ink); border-color: var(--rule); }
.btn.acc { background: var(--accent); color: #fff; }
.tlink { font-size: 16px; font-weight: 650; color: var(--accent-2); text-decoration: none; border-bottom: 1px solid var(--accent-line); padding-bottom: 3px; }

/* flat product regions. no chrome, no radius, no shadow. */
.flat { border: 1px solid var(--rule); background: var(--card); display: flex; flex-direction: column; }
.flat .fbar { display: flex; align-items: baseline; gap: 10px; padding: 11px 14px; border-bottom: 1px solid var(--hair); }
.flat .fbar .ft { font-size: 12px; font-weight: 700; color: var(--body); letter-spacing: -0.01em; }
.flat .fbar .fs { font-size: 11px; font-weight: 600; color: var(--light); margin-left: auto; }
.flat .fb { padding: 16px 14px; display: flex; flex-direction: column; gap: 9px; flex: 1; }
.sk { background: #241d38; }
.sk.line { height: 9px; }
.sk.acc { background: var(--accent-line); }
.bars { display: flex; align-items: flex-end; gap: 8px; flex: 1; min-height: 74px; padding-top: 6px; }
.bars i { flex: 1; display: block; background: var(--accent); }
.bars i.lt { background: var(--accent-line); }
.axis { display: flex; gap: 8px; }
.axis span { flex: 1; font-size: 10px; font-weight: 600; color: var(--light); text-align: center; }
.rowline { display: flex; gap: 10px; align-items: center; }
.rowline .av { width: 22px; height: 22px; background: var(--accent-line); flex: none; }
.rowline .sk.line { flex: 1; }
.rowline .tag { font-size: 10px; font-weight: 700; color: var(--accent-2); border: 1px solid var(--accent-line); padding: 2px 7px; }

/* photo cells fill their cell edge to edge */
.pic { background-size: cover; background-position: center; min-height: 100%; }
.pic.tall { min-height: 420px; }

/* hero */
.hero .cells { min-height: 620px; }
.heropic { background: url("hero.jpg") center 55% / cover no-repeat; min-height: 560px; }
.herocap { position: relative; }
.herocap .ic { position: absolute; left: 26px; right: 26px; bottom: 30px; z-index: 2; }

/* module index — the platform, as a ruled table */
.modrow { display: grid; grid-template-columns: 46px 260px minmax(0,1fr) 300px; gap: 0; border-top: 1px solid var(--hair); align-items: center; }
.modrow:first-child { border-top: none; }
.modrow > * { padding: 22px 20px; }
.modrow .mi { font-size: 13px; font-weight: 600; color: var(--light); }
.modrow .mn { font-size: 26px; font-weight: 700; color: var(--ink); letter-spacing: -0.032em; }
.modrow .md { font-size: 15.5px; color: var(--mid); }
.modrow .mg { padding: 14px 20px; }
.modrow .mg .flat { border-color: var(--hair); }
.modrow .mg .fb { min-height: 62px; padding: 12px; gap: 7px; }

/* gradient field. full bleed, no radius, no inset panel. */
.field { position: relative; }
.field .gr { position: absolute; inset: 0; z-index: 0; background-size: cover; background-position: center; }
.field .gr::after { content: ""; position: absolute; inset: 0; }
.field .cells, .field .lines { position: relative; z-index: 2; }
.field .lines { position: absolute; }
.field.on-light .lines span { border-left-color: rgba(39,6,92,0.20); }
.field.on-light { border-bottom-color: rgba(39,6,92,0.28); }
.field.on-light h2, .field.on-light .dsp { color: var(--dark); }
.field.on-light .eyebrow { color: rgba(39,6,92,0.78); }
.field.on-light .lede { color: var(--dark); }
.field.on-light .txt { color: rgba(39,6,92,0.72); }
.field.on-light .marg { color: rgba(39,6,92,0.62); }

/* portraits sit flush in their cells */
.port { position: relative; min-height: 440px; background-size: cover; background-position: center 20%; display: flex; align-items: flex-end; }
.port::before { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 45%, rgba(14,10,24,0.80)); }
.port .pin { position: relative; z-index: 2; padding: 20px; }
.port .pn { display: block; font-size: 17px; font-weight: 700; color: #fff; letter-spacing: -0.022em; }
.port .pr { display: block; font-size: 13.5px; font-weight: 600; color: rgba(255,255,255,0.74); margin-top: 3px; }
.p1 { background-image: url("https://images.unsplash.com/photo-1494790108377-be9c29b29330?q=80&w=800&auto=format&fit=crop"); }
.p2 { background-image: url("https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=800&auto=format&fit=crop"); }
.p3 { background-image: url("https://images.unsplash.com/photo-1580489944761-15a19d654956?q=80&w=800&auto=format&fit=crop"); }
.p4 { background-image: url("https://images.unsplash.com/photo-1560250097-0b93528c311a?q=80&w=800&auto=format&fit=crop"); }
.gp { background-image: url("https://images.unsplash.com/photo-1587061949409-02df41d5e562?q=80&w=900&auto=format&fit=crop"); }
.go { background-image: url("https://images.unsplash.com/photo-1475483768296-6163e08872a1?q=80&w=900&auto=format&fit=crop"); }
.gb { background-image: url("https://images.unsplash.com/photo-1439066615861-d1af74d74000?q=80&w=900&auto=format&fit=crop"); }

/* the phone keeps a radius. it is a device, not a container. */
.phone { width: 300px; background: var(--card); border: 1px solid var(--rule); border-radius: 30px; padding: 16px 14px 22px; }
.phone .notch { width: 96px; height: 20px; border-radius: 100px; background: rgba(255,255,255,0.9); margin: 0 auto 16px; }
.phone .app { font-size: 11px; font-weight: 700; color: var(--accent-2); text-align: center; margin-bottom: 14px; letter-spacing: -0.005em; }
.bub { max-width: 84%; border-radius: 14px; padding: 11px 13px; font-size: 13.5px; line-height: 1.42; margin-bottom: 9px; font-weight: 550; font-family: var(--sans); }
.bub.q { margin-left: auto; background: var(--accent); color: #fff; border-bottom-right-radius: 4px; }
.bub.a { background: #241d38; color: var(--body); border-bottom-left-radius: 4px; }
.bub.typing { display: inline-flex; gap: 5px; align-items: center; padding: 13px 15px; }
.bub.typing i { width: 6px; height: 6px; border-radius: 50%; background: var(--light); display: block; }

/* stats — a ruled strip of four, numbers only, no cards */
.statcell { display: flex; flex-direction: column; justify-content: flex-end; padding: 44px 26px 40px; }
.statcell .sv { font-size: 66px; font-weight: 700; color: var(--ink); letter-spacing: -0.05em; line-height: 0.92; }
.statcell .sl { margin-top: 14px; font-size: 15px; color: var(--mid); line-height: 1.38; }

/* quote */
.qb { font-size: 50px; font-weight: 400; letter-spacing: -0.038em; line-height: 1.08; color: var(--ink); }
.qb b { font-weight: 700; }
.qb .qm { color: var(--accent-2); }
.attr .an { font-size: 18px; font-weight: 700; color: var(--ink); letter-spacing: -0.022em; }
.attr .ar { font-size: 14.5px; font-weight: 600; color: var(--mid); margin-top: 2px; }
.attr .ac { font-size: 14px; font-weight: 650; color: var(--accent-2); margin-top: 2px; }

/* logo wall — bare cells of the grid, nothing but the hairline */
.lgcell { height: 108px; display: flex; align-items: center; justify-content: center; border-top: 1px solid var(--hair); }
.lgcell .lmark { width: 82px; height: 22px; background: rgba(255,255,255,0.16); }
.lgcell.on { position: relative; }
.lgcell.on .lmark { background: var(--accent-line); }
.lgcell.on .story { position: absolute; bottom: 12px; left: 0; right: 0; text-align: center; font-size: 12px; font-weight: 650; color: var(--accent-2); }

/* close */
.close { position: relative; min-height: 660px; display: flex; align-items: flex-end;
  background: linear-gradient(180deg, rgba(13,10,22,0.34), rgba(13,10,22,0.20) 40%, rgba(13,10,22,0.80)),
  url("https://images.unsplash.com/photo-1758272960816-6126b6607596?q=80&w=2400&auto=format&fit=crop") center 42% / cover no-repeat; }
.close .cells { width: 100%; }

/* footer */
.hp-foot .cells { min-height: 96px; align-items: center; }
.hp-foot .c { padding: 30px 22px; display: flex; align-items: center; }
.hp-foot a { font-size: 13.5px; font-weight: 600; color: var(--dark-mid); text-decoration: none; }
.hp-foot .legal { font-size: 12.5px; color: var(--dark-low); font-weight: 600; }
.hp-foot .cmlogo { height: 20px; }

/* ── type program ── */
@font-face { font-family:"SF Sym"; src:local("SF Pro Display"), local("SF Pro Text"), local("Helvetica Neue"); font-weight:400; unicode-range:U+0024-0026, U+0028-0029, U+002B, U+002F, U+003C-003E, U+005B, U+005D, U+00A9, U+00AE, U+00B0, U+00B7, U+2013-2014, U+2018-2019, U+201C-201D, U+2122, U+2192; }
@font-face { font-family:"SF Sym"; src:local("SF Pro Display Medium"), local("SFProDisplay-Medium"), local("SF Pro Text Medium"); font-weight:500; unicode-range:U+0024-0026, U+0028-0029, U+002B, U+002F, U+003C-003E, U+005B, U+005D, U+00A9, U+00AE, U+00B0, U+00B7, U+2013-2014, U+2018-2019, U+201C-201D, U+2122, U+2192; }
@font-face { font-family:"SF Sym"; src:local("SF Pro Display Semibold"), local("SFProDisplay-Semibold"), local("SF Pro Text Semibold"); font-weight:600; unicode-range:U+0024-0026, U+0028-0029, U+002B, U+002F, U+003C-003E, U+005B, U+005D, U+00A9, U+00AE, U+00B0, U+00B7, U+2013-2014, U+2018-2019, U+201C-201D, U+2122, U+2192; }
@font-face { font-family:"SF Sym"; src:local("SF Pro Display Bold"), local("SFProDisplay-Bold"), local("SF Pro Text Bold"); font-weight:700; unicode-range:U+0024-0026, U+0028-0029, U+002B, U+002F, U+003C-003E, U+005B, U+005D, U+00A9, U+00AE, U+00B0, U+00B7, U+2013-2014, U+2018-2019, U+201C-201D, U+2122, U+2192; }
@font-face { font-family:"Spezia Narrow"; src:url("fonts/SpeziaNarrowWeb_TEST-FONT_Regular.woff2") format("woff2"); font-weight:400; font-display:block; }
@font-face { font-family:"Spezia Narrow"; src:url("fonts/SpeziaNarrowWeb_TEST-FONT_Medium.woff2") format("woff2"); font-weight:500; font-display:block; }
@font-face { font-family:"Spezia Narrow"; src:url("fonts/SpeziaNarrowWeb_TEST-FONT_SemiBold.woff2") format("woff2"); font-weight:600; font-display:block; }
@font-face { font-family:"Spezia Narrow"; src:url("fonts/SpeziaNarrowWeb_TEST-FONT_Bold.woff2") format("woff2"); font-weight:700; font-display:block; }
@font-face { font-family:"Spezia"; src:url("fonts/SpeziaWeb_TEST-FONT_Regular.woff2") format("woff2"); font-weight:400; font-display:block; }
@font-face { font-family:"Spezia"; src:url("fonts/SpeziaWeb_TEST-FONT_Medium.woff2") format("woff2"); font-weight:500; font-display:block; }
@font-face { font-family:"Spezia"; src:url("fonts/SpeziaWeb_TEST-FONT_SemiBold.woff2") format("woff2"); font-weight:600; font-display:block; }
@font-face { font-family:"Spezia"; src:url("fonts/SpeziaWeb_TEST-FONT_Bold.woff2") format("woff2"); font-weight:700; font-display:block; }
@font-face { font-family:"Spezia SemiMono"; src:url("fonts/SpeziaSemiMonoWeb_TEST-FONT_Medium.woff2") format("woff2"); font-weight:500; font-display:block; }
.hp { font-family:"SF Sym", "Spezia Narrow", var(--sans); }
.hp .lede, .hp .txt, .hp .btn, .hp .tlink, .hp-nav a, .hp .modrow .md, .hp .statcell .sl,
.hp .attr .ar, .hp .attr .ac, .hp .port .pr, .hp-foot a, .hp .qb { font-family:"SF Sym", "Spezia", var(--sans); }
/* the marginal apparatus runs semi-mono. it is the apparatus, not the voice. */
.hp .marg, .hp .modrow .mi, .hp .axis span, .hp .flat .fbar .fs, .hp .lgcell .story,
.hp .hp-foot .legal { font-family:"SF Sym", "Spezia SemiMono", var(--sans); letter-spacing: 0.01em; }
.hp .flat, .hp .phone { font-family: var(--sans); }
.hp .statcell .sv { font-variant-numeric: normal; }

/* ── motion ── */
@keyframes barpulse { 0%,100% { transform: scaleY(1); } 50% { transform: scaleY(0.84); } }
@keyframes linegrow { 0%,100% { transform: scaleX(1); } 50% { transform: scaleX(0.86); } }
@keyframes dotpulse { 0%,100% { opacity: 0.32; transform: translateY(0); } 50% { opacity: 1; transform: translateY(-3px); } }
.bars.anim i { transform-origin: 50% 100%; animation: barpulse 5.6s cubic-bezier(0.45,0,0.55,1) infinite; will-change: transform; }
.bars.anim i:nth-child(1){animation-delay:0s}.bars.anim i:nth-child(2){animation-delay:.26s}
.bars.anim i:nth-child(3){animation-delay:.52s}.bars.anim i:nth-child(4){animation-delay:.78s}
.bars.anim i:nth-child(5){animation-delay:1.04s}.bars.anim i:nth-child(6){animation-delay:1.3s}
.anim-lines .sk.line { transform-origin: 0% 50%; animation: linegrow 4.8s ease-in-out infinite; }
.anim-lines .sk.line:nth-child(2){animation-delay:.5s}.anim-lines .sk.line:nth-child(3){animation-delay:1s}
.bub.typing i { animation: dotpulse 1.5s ease-in-out infinite; }
.bub.typing i:nth-child(2){animation-delay:.18s}.bub.typing i:nth-child(3){animation-delay:.36s}
@media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }
</style>
</head>
<body>

